{% extends 'layout.html.twig' %}
{% set activeMenu = 'payments' %}
{% block title %}Paiements{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-on-surface">Paiements</h1>
    <a href="/payments/new" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-br from-primary to-primary-dim text-on-primary rounded-xl font-semibold text-sm hover:opacity-95 transition-opacity">
        <span class="material-symbols-outlined text-[18px]">add</span>
        Nouveau
    </a>
</div>

{# Filter bar #}
<form method="get" action="/payments" class="flex gap-3 mb-6">
    <input type="text" name="period" placeholder="YYYY-MM" value="{{ filter.period }}"
           class="bg-surface-container-lowest rounded-lg px-4 py-2.5 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary w-40">
    <button type="submit"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-surface-container-high text-on-surface rounded-lg text-sm font-medium hover:bg-surface-container-highest transition-colors">
        <span class="material-symbols-outlined text-[16px]">filter_list</span>
        Filtrer
    </button>
    {% if filter.period %}
        <a href="/payments"
           class="inline-flex items-center gap-1.5 px-4 py-2.5 text-on-surface-variant rounded-lg text-sm hover:text-on-surface transition-colors">
            <span class="material-symbols-outlined text-[16px]">close</span>
            Réinitialiser
        </a>
    {% endif %}
</form>

<div class="bg-surface-container-lowest rounded-xl custom-shadow overflow-hidden">
    {% if payments is empty %}
        <div class="px-6 py-12 text-center text-on-surface-variant text-sm">Aucun paiement{{ filter.period ? ' pour ' ~ filter.period : '' }}.</div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low/50">
                        <th class="px-6 py-4 text-[10px] text-on-surface-variant font-bold tracking-widest uppercase hidden md:table-cell">#</th>
                        <th class="px-6 py-4 text-[10px] text-on-surface-variant font-bold tracking-widest uppercase">Période</th>
                        <th class="px-6 py-4 text-[10px] text-on-surface-variant font-bold tracking-widest uppercase">Locataire</th>
                        <th class="px-6 py-4 text-[10px] text-on-surface-variant font-bold tracking-widest uppercase hidden md:table-cell">Loyer</th>
                        <th class="px-6 py-4 text-[10px] text-on-surface-variant font-bold tracking-widest uppercase hidden md:table-cell">Charges</th>
                        <th class="px-6 py-4 text-[10px] text-on-surface-variant font-bold tracking-widest uppercase hidden md:table-cell">Payé le</th>
                        <th class="px-6 py-4"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-low">
                {% for p in payments %}
                    <tr class="hover:bg-surface-container-low/30 transition-colors">
                        <td class="px-6 py-4 text-on-surface-variant text-xs hidden md:table-cell">#{{ p.id }}</td>
                        <td class="px-6 py-4 text-on-surface text-sm font-medium">{{ p.period }}</td>
                        <td class="px-6 py-4 text-on-surface text-sm">{{ tenants[p.tenant_id].full_name ?? p.tenant_id }}</td>
                        <td class="px-6 py-4 text-on-surface text-sm hidden md:table-cell">{{ (p.rent_amount / 100)|number_format(2, ',', ' ') }} €</td>
                        <td class="px-6 py-4 text-on-surface-variant text-sm hidden md:table-cell">{{ (p.charges_amount / 100)|number_format(2, ',', ' ') }} €</td>
                        <td class="px-6 py-4 text-on-surface-variant text-sm hidden md:table-cell">{{ p.paid_at }}</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/payments/{{ p.id }}/edit"
                                   class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface-container-high text-on-surface rounded-lg text-xs font-medium hover:bg-surface-container-highest transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">edit</span>
                                    <span class="hidden md:inline">Modifier</span>
                                </a>
                                <form method="post" action="/payments/{{ p.id }}/process-receipt">
                                    <button class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-tertiary-container/40 text-on-tertiary-container rounded-lg text-xs font-medium hover:bg-tertiary-container/60 transition-colors">
                                        <span class="material-symbols-outlined text-[14px]">receipt_long</span>
                                        <span class="hidden md:inline">Quittance</span>
                                    </button>
                                </form>
                                <form method="post" action="/payments/{{ p.id }}/delete"
                                      onsubmit="return confirm('Supprimer ce paiement ?')">
                                    <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-error bg-error-container/10 rounded-lg text-xs font-medium hover:bg-error-container/25 transition-colors">
                                        <span class="material-symbols-outlined text-[14px]">delete</span>
                                        <span class="hidden md:inline">Suppr.</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
