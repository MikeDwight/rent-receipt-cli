{% extends 'layout.html.twig' %}
{% set activeMenu = 'payments' %}
{% block title %}Paiements{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Paiements</h2>
    <a href="/payments/new" class="btn btn-primary btn-sm">+ Nouveau</a>
</div>

<form method="get" action="/payments" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="period" class="form-control form-control-sm" placeholder="YYYY-MM" value="{{ filter.period }}">
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filtrer</button>
        <a href="/payments" class="btn btn-sm btn-link">Réinitialiser</a>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Période</th><th>Locataire</th><th>Bien</th><th>Loyer</th><th>Charges</th><th>Payé le</th><th></th></tr>
            </thead>
            <tbody>
            {% for p in payments %}
                <tr>
                    <td class="text-muted">{{ p.id }}</td>
                    <td>{{ p.period }}</td>
                    <td>{{ tenants[p.tenant_id].full_name ?? p.tenant_id }}</td>
                    <td>{{ properties[p.property_id].label ?? p.property_id }}</td>
                    <td>{{ (p.rent_amount / 100)|number_format(2, ',', ' ') }} €</td>
                    <td>{{ (p.charges_amount / 100)|number_format(2, ',', ' ') }} €</td>
                    <td>{{ p.paid_at }}</td>
                    <td class="text-end">
                        <a href="/payments/{{ p.id }}/edit" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        <form method="post" action="/payments/{{ p.id }}/delete" class="d-inline"
                              onsubmit="return confirm('Supprimer ce paiement ?')">
                            <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="text-muted text-center py-3">Aucun paiement.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
