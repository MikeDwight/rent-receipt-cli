{% extends 'layout.html.twig' %}
{% set activeMenu = 'payments' %}
{% block title %}Paiements{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fs-4">Paiements</h2>
    <a href="/payments/new" class="btn btn-primary btn-sm">+ Nouveau</a>
</div>

<form method="get" action="/payments" class="row g-2 mb-3">
    <div class="col">
        <input type="text" name="period" class="form-control form-control-sm" placeholder="YYYY-MM" value="{{ filter.period }}">
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filtrer</button>
        <a href="/payments" class="btn btn-sm btn-link">Réinitialiser</a>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="d-none d-md-table-cell">#</th>
                    <th>Période</th>
                    <th>Locataire</th>
                    <th class="d-none d-md-table-cell">Loyer</th>
                    <th class="d-none d-md-table-cell">Charges</th>
                    <th class="d-none d-md-table-cell">Payé le</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for p in payments %}
                <tr>
                    <td class="text-muted d-none d-md-table-cell">{{ p.id }}</td>
                    <td>{{ p.period }}</td>
                    <td>{{ tenants[p.tenant_id].full_name ?? p.tenant_id }}</td>
                    <td class="d-none d-md-table-cell">{{ (p.rent_amount / 100)|number_format(2, ',', ' ') }} €</td>
                    <td class="d-none d-md-table-cell">{{ (p.charges_amount / 100)|number_format(2, ',', ' ') }} €</td>
                    <td class="d-none d-md-table-cell">{{ p.paid_at }}</td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Actions
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/payments/{{ p.id }}/edit">Modifier</a></li>
                                <li>
                                    <form method="post" action="/payments/{{ p.id }}/process-receipt">
                                        <button class="dropdown-item">Générer quittance</button>
                                    </form>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="/payments/{{ p.id }}/delete"
                                          onsubmit="return confirm('Supprimer ce paiement ?')">
                                        <button class="dropdown-item text-danger">Supprimer</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-muted text-center py-3">Aucun paiement.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
