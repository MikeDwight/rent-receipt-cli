{% extends 'layout.html.twig' %}
{% set activeMenu = 'payments' %}
{% block title %}{{ payment ? 'Modifier paiement' : 'Nouveau paiement' }}{% endblock %}

{% block content %}
<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/payments" class="btn btn-sm btn-outline-secondary">← Retour</a>
    <h2 class="mb-0">{{ payment ? 'Modifier paiement' : 'Nouveau paiement' }}</h2>
</div>

<div class="card border-0 shadow-sm" style="max-width:600px">
    <div class="card-body">
        <form method="post" action="{{ payment ? '/payments/' ~ payment.id : '/payments' }}">
            <div class="row g-3 mb-3">
                <div class="col">
                    <label class="form-label">Locataire <span class="text-danger">*</span></label>
                    <select name="tenant_id" class="form-select" required>
                        <option value="">-- choisir --</option>
                        {% for t in tenants %}
                            <option value="{{ t.id }}" {{ (payment.tenant_id ?? '') == t.id ? 'selected' : '' }}>{{ t.full_name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col">
                    <label class="form-label">Bien <span class="text-danger">*</span></label>
                    <select id="property_id" name="property_id" class="form-select" required>
                        <option value="">-- choisir --</option>
                        {% for p in properties %}
                            <option value="{{ p.id }}" {{ (payment.property_id ?? preselectedProperty.id ?? '') == p.id ? 'selected' : '' }}>{{ p.label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Période <span class="text-danger">*</span></label>
                <div class="d-flex gap-2 mb-2">
                    <button type="button" id="btn-m" class="btn btn-sm btn-outline-secondary" onclick="fillMonth(0)"></button>
                    <button type="button" id="btn-m1" class="btn btn-sm btn-outline-secondary" onclick="fillMonth(1)"></button>
                </div>
                <input type="hidden" id="period" name="period" value="{{ payment.period ?? currentMonth }}">
                <input type="hidden" id="period_start" name="period_start" value="{{ payment.period_start ?? '' }}">
                <input type="hidden" id="period_end" name="period_end" value="{{ payment.period_end ?? '' }}">
                <input type="text" id="period_display" class="form-control" readonly placeholder="Sélectionnez une période">
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="prorata_check">
                    <label class="form-check-label" for="prorata_check">Entrée en cours de mois (prorata)</label>
                </div>
                <div id="prorata_section" class="mt-2 p-3 bg-light rounded" style="display:none">
                    <div class="d-flex gap-2 align-items-center mb-2">
                        <div>
                            <label class="form-label small mb-1">Du</label>
                            <input type="date" id="prorata_start" class="form-control form-control-sm">
                        </div>
                        <div>
                            <label class="form-label small mb-1">Au</label>
                            <input type="date" id="prorata_end" class="form-control form-control-sm">
                        </div>
                    </div>
                    <div id="prorata_result" class="small text-muted"></div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col">
                    <label class="form-label">Loyer (€) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" id="rent_amount" name="rent_amount" class="form-control"
                           value="{{ payment ? (payment.rent_amount / 100)|number_format(2, '.', '') : (preselectedProperty ? (preselectedProperty.rent_amount / 100)|number_format(2, '.', '') : '') }}"
                           required>
                </div>
                <div class="col">
                    <label class="form-label">Charges (€)</label>
                    <input type="number" step="0.01" id="charges_amount" name="charges_amount" class="form-control"
                           value="{{ payment ? (payment.charges_amount / 100)|number_format(2, '.', '') : (preselectedProperty ? (preselectedProperty.charges_amount / 100)|number_format(2, '.', '') : '0.00') }}">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Payé le <span class="text-danger">*</span></label>
                <input type="date" name="paid_at" class="form-control"
                       value="{{ payment.paid_at ?? "now"|date("Y-m-d") }}" required>
            </div>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
<script>
const PROPERTIES = {
    {% for p in properties %}
    {{ p.id }}: { rent: {{ (p.rent_amount / 100)|number_format(2, '.', '') }}, charges: {{ (p.charges_amount / 100)|number_format(2, '.', '') }} },
    {% endfor %}
};

const isNewPayment  = {{ payment is null ? 'true' : 'false' }};
const propertySelect = document.getElementById('property_id');
const rentInput      = document.getElementById('rent_amount');
const chargesInput   = document.getElementById('charges_amount');

// ── Property auto-select & amount fill ──────────────────────────────────────
function fillAmountsFromProperty(id) {
    if (!isNewPayment || !id || !PROPERTIES[id]) return;
    rentInput.value    = PROPERTIES[id].rent.toFixed(2);
    chargesInput.value = PROPERTIES[id].charges.toFixed(2);
}

propertySelect.addEventListener('change', () => {
    fillAmountsFromProperty(propertySelect.value);
    updateProrata();
});

if (isNewPayment && Object.keys(PROPERTIES).length === 1) {
    const onlyId = Object.keys(PROPERTIES)[0];
    if (!propertySelect.value) propertySelect.value = onlyId;
    fillAmountsFromProperty(propertySelect.value);
}

// ── Period shortcuts ─────────────────────────────────────────────────────────
const MONTHS_FR = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];

function formatPeriod(ym) {
    if (!ym) return '';
    const [year, mon] = ym.split('-');
    return MONTHS_FR[parseInt(mon, 10) - 1] + ' ' + year;
}

function fillMonth(offset) {
    const now = new Date();
    const d   = new Date(now.getFullYear(), now.getMonth() + offset, 1);
    const ym  = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
    document.getElementById('period').value         = ym;
    document.getElementById('period_display').value = formatPeriod(ym);
    document.getElementById('period_start').value   = '';
    document.getElementById('period_end').value     = '';
    if (document.getElementById('prorata_check').checked) updateProrata();
}

// Initialize display from existing value on page load
(function () {
    const ym = document.getElementById('period').value;
    if (ym) document.getElementById('period_display').value = formatPeriod(ym);
})();

document.getElementById('btn-m').textContent  = MONTHS_FR[new Date().getMonth()];
document.getElementById('btn-m1').textContent = MONTHS_FR[(new Date().getMonth() + 1) % 12];

// ── Prorata ──────────────────────────────────────────────────────────────────
const prorataCheck   = document.getElementById('prorata_check');
const prorataSection = document.getElementById('prorata_section');
const prorataResult  = document.getElementById('prorata_result');
const prorataStart   = document.getElementById('prorata_start');
const prorataEnd     = document.getElementById('prorata_end');

flatpickr('#prorata_start', { locale: 'fr', dateFormat: 'Y-m-d', onChange: updateProrata });
flatpickr('#prorata_end',   { locale: 'fr', dateFormat: 'Y-m-d', onChange: updateProrata });

prorataCheck.addEventListener('change', function () {
    prorataSection.style.display = this.checked ? '' : 'none';
    if (!this.checked) {
        document.getElementById('period_start').value = '';
        document.getElementById('period_end').value   = '';
        prorataResult.textContent = '';
        fillAmountsFromProperty(propertySelect.value);
    }
});

function updateProrata() {
    if (!prorataCheck.checked) return;

    const startVal = prorataStart.value;
    const endVal   = prorataEnd.value;
    if (!startVal || !endVal) return;

    const start = new Date(startVal);
    const end   = new Date(endVal);
    if (end < start) return;

    // Period = month of start date
    const ym = startVal.slice(0, 7);
    document.getElementById('period').value         = ym;
    document.getElementById('period_display').value = formatPeriod(ym) + ' (prorata)';
    document.getElementById('period_start').value   = startVal;
    document.getElementById('period_end').value     = endVal;

    // Days in the month
    const [year, mon] = ym.split('-').map(Number);
    const daysInMonth = new Date(year, mon, 0).getDate();

    // Days occupied (inclusive)
    const daysOccupied = Math.round((end - start) / 86400000) + 1;
    const ratio        = daysOccupied / daysInMonth;

    // Base amounts from property defaults
    const propId = propertySelect.value;
    const baseRent    = propId && PROPERTIES[propId] ? PROPERTIES[propId].rent    : parseFloat(rentInput.value)    || 0;
    const baseCharges = propId && PROPERTIES[propId] ? PROPERTIES[propId].charges : parseFloat(chargesInput.value) || 0;

    const prorataRent    = Math.round(baseRent    * ratio * 100) / 100;
    const prorataCharges = Math.round(baseCharges * ratio * 100) / 100;

    rentInput.value    = prorataRent.toFixed(2);
    chargesInput.value = prorataCharges.toFixed(2);

    const pct = (ratio * 100).toFixed(1).replace('.', ',');
    const fmtDate = v => v.split('-').reverse().join('/');
    prorataResult.innerHTML =
        `${fmtDate(startVal)} → ${fmtDate(endVal)} &nbsp;·&nbsp; ` +
        `<strong>${daysOccupied} j / ${daysInMonth} j</strong> = ${pct}% &nbsp;·&nbsp; ` +
        `Loyer : <strong>${prorataRent.toFixed(2).replace('.', ',')} €</strong>, ` +
        `Charges : <strong>${prorataCharges.toFixed(2).replace('.', ',')} €</strong>`;
}
</script>
{% endblock %}
