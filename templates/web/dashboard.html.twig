{% extends 'layout.html.twig' %}
{% set activeMenu = 'dashboard' %}
{% block title %}Tableau de bord{% endblock %}

{% block content %}
<h2 class="mb-4 fs-4">Tableau de bord</h2>

<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="display-6 text-primary fw-bold">{{ ownerCount }}</div>
                <div class="text-muted small">Bailleurs</div>
                <a href="/owners" class="btn btn-sm btn-outline-primary mt-2">Gérer</a>
            </div>
        </div>
    </div>
    <div class="col-4">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="display-6 text-success fw-bold">{{ tenantCount }}</div>
                <div class="text-muted small">Locataires</div>
                <a href="/tenants" class="btn btn-sm btn-outline-success mt-2">Gérer</a>
            </div>
        </div>
    </div>
    <div class="col-4">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="display-6 text-info fw-bold">{{ propertyCount }}</div>
                <div class="text-muted small">Biens</div>
                <a href="/properties" class="btn btn-sm btn-outline-info mt-2">Gérer</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Actions rapides</div>
            <div class="card-body d-flex flex-column gap-2">
                <a href="/payments/new" class="btn btn-outline-primary">+ Nouveau paiement</a>
                <a href="/payments" class="btn btn-outline-secondary">Voir les paiements</a>
                <a href="/receipts" class="btn btn-outline-secondary">Voir les quittances</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                📋 Quittances — {{ currentMonth }}
            </div>
            <div class="card-body p-0">
                {% if currentReceipts is empty %}
                    <p class="text-muted p-3 mb-0">Aucune quittance ce mois.</p>
                {% else %}
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Locataire</th><th>Email</th><th>Archivé</th></tr>
                        </thead>
                        <tbody>
                        {% for r in currentReceipts %}
                            <tr>
                                <td>{{ r.tenant_name ?? r.period ?? '—' }}</td>
                                <td>{% if r.sent_at %}<span class="badge bg-success">✓</span>{% else %}<span class="badge bg-secondary">—</span>{% endif %}</td>
                                <td>{% if r.archived_at %}<span class="badge bg-success">✓</span>{% else %}<span class="badge bg-secondary">—</span>{% endif %}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
            <div class="card-footer bg-white text-end">
                <a href="/receipts" class="btn btn-sm btn-outline-secondary">Voir toutes →</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
