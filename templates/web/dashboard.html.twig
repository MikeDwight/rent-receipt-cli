{% extends 'layout.html.twig' %}
{% set activeMenu = 'dashboard' %}
{% block title %}Tableau de bord{% endblock %}

{% block content %}
<h2 class="mb-4">Tableau de bord</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="display-6 text-primary fw-bold">{{ ownerCount }}</div>
                <div class="text-muted">Bailleurs</div>
                <a href="/owners" class="btn btn-sm btn-outline-primary mt-2">Gérer</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="display-6 text-success fw-bold">{{ tenantCount }}</div>
                <div class="text-muted">Locataires</div>
                <a href="/tenants" class="btn btn-sm btn-outline-success mt-2">Gérer</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <div class="display-6 text-info fw-bold">{{ propertyCount }}</div>
                <div class="text-muted">Biens</div>
                <a href="/properties" class="btn btn-sm btn-outline-info mt-2">Gérer</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                ⚡ Traiter un paiement
                <span class="text-muted fw-normal small">(mois en cours : {{ currentMonth }})</span>
            </div>
            <div class="card-body">
                <form method="post" action="/receipts/process">
                    <div class="mb-2">
                        <label class="form-label small">Locataire</label>
                        <select name="tenant_id" class="form-select form-select-sm" required>
                            <option value="">-- choisir --</option>
                            {% for t in tenants %}
                                <option value="{{ t.id }}">{{ t.full_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Bien</label>
                        <select name="property_id" class="form-select form-select-sm" required>
                            <option value="">-- choisir --</option>
                            {% for p in properties %}
                                <option value="{{ p.id }}">{{ p.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label class="form-label small">Période</label>
                            <input type="text" name="period" class="form-control form-control-sm" value="{{ currentMonth }}" placeholder="YYYY-MM">
                        </div>
                        <div class="col">
                            <label class="form-label small">Payé le</label>
                            <input type="date" name="paid_at" class="form-control form-control-sm" value="{{ "now"|date("Y-m-d") }}">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">Traiter →</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                📋 Quittances — {{ currentMonth }}
            </div>
            <div class="card-body p-0">
                {% if currentReceipts is empty %}
                    <p class="text-muted p-3 mb-0">Aucune quittance ce mois.</p>
                {% else %}
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Période</th><th>Envoyé</th><th>Archivé</th></tr>
                        </thead>
                        <tbody>
                        {% for r in currentReceipts %}
                            <tr>
                                <td>{{ r.period ?? '—' }}</td>
                                <td>{% if r.sent_at %}<span class="badge bg-success">✓</span>{% else %}<span class="badge bg-secondary">—</span>{% endif %}</td>
                                <td>{% if r.archived_at %}<span class="badge bg-success">✓</span>{% else %}<span class="badge bg-secondary">—</span>{% endif %}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
            <div class="card-footer bg-white text-end">
                <a href="/receipts" class="btn btn-sm btn-outline-secondary">Voir toutes →</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
