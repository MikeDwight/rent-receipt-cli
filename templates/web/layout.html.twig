<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Rent Receipt{% endblock %} — Rent Receipt</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "background": "#fcf9f8",
                        "surface": "#fcf9f8",
                        "surface-bright": "#fcf9f8",
                        "surface-dim": "#dbdad9",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f6f3f2",
                        "surface-container": "#f0eded",
                        "surface-container-high": "#eae8e7",
                        "surface-container-highest": "#e4e2e2",
                        "on-surface": "#323233",
                        "on-surface-variant": "#5f5f5f",
                        "outline": "#7b7b7a",
                        "outline-variant": "#b2b2b1",
                        "primary": "#565e74",
                        "primary-dim": "#4a5268",
                        "primary-fixed": "#dae2fd",
                        "primary-fixed-dim": "#ccd4ee",
                        "on-primary": "#f7f7ff",
                        "on-primary-fixed": "#373f54",
                        "primary-container": "#dae2fd",
                        "on-primary-container": "#4a5167",
                        "secondary": "#526074",
                        "secondary-dim": "#465468",
                        "secondary-container": "#d5e3fc",
                        "on-secondary": "#f8f8ff",
                        "on-secondary-container": "#455367",
                        "tertiary": "#006d4a",
                        "tertiary-dim": "#005f40",
                        "tertiary-container": "#69f6b8",
                        "on-tertiary": "#e6ffee",
                        "on-tertiary-container": "#005a3c",
                        "error": "#9f403d",
                        "error-container": "#fe8983",
                        "on-error": "#fff7f6",
                        "on-error-container": "#752121",
                        "inverse-surface": "#0e0e0e",
                        "inverse-on-surface": "#9e9c9c",
                        "surface-tint": "#565e74",
                        "surface-variant": "#e4e2e2",
                    },
                    borderRadius: {
                        DEFAULT: "0.125rem",
                        lg: "0.25rem",
                        xl: "0.75rem",
                        "2xl": "1rem",
                        full: "9999px",
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .custom-shadow { box-shadow: 0 12px 40px rgba(50, 50, 51, 0.06); }
        .sidebar-link { @apply flex items-center gap-3 px-3 py-2 rounded-lg transition-all duration-200 text-sm font-medium; }
        .sidebar-link-inactive { @apply text-slate-400 hover:text-slate-200 hover:bg-slate-800/30; }
        .sidebar-link-active { @apply text-white bg-slate-800/50 font-semibold; }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen">

{# ── Desktop Sidebar ─────────────────────────────────────────────────── #}
<aside class="fixed h-full w-[220px] left-0 top-0 hidden lg:flex flex-col bg-slate-950 p-4 gap-2 z-50">
    <div class="mb-6 px-2 flex flex-col">
        <span class="text-xl font-bold tracking-tighter text-white">Rent Receipt</span>
        <span class="text-xs text-slate-400 tracking-tight">Gestion immobilière</span>
    </div>
    <nav class="flex flex-col gap-1 flex-grow">
        <a href="/" class="sidebar-link {{ activeMenu == 'dashboard' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">dashboard</span>
            <span>Tableau de bord</span>
        </a>
        <p class="px-3 pt-4 pb-1 text-[10px] font-bold tracking-widest text-slate-600 uppercase">Gestion</p>
        <a href="/owners" class="sidebar-link {{ activeMenu == 'owners' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">person</span>
            <span>Bailleurs</span>
        </a>
        <a href="/tenants" class="sidebar-link {{ activeMenu == 'tenants' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">groups</span>
            <span>Locataires</span>
        </a>
        <a href="/properties" class="sidebar-link {{ activeMenu == 'properties' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">apartment</span>
            <span>Biens</span>
        </a>
        <p class="px-3 pt-4 pb-1 text-[10px] font-bold tracking-widest text-slate-600 uppercase">Loyers</p>
        <a href="/payments" class="sidebar-link {{ activeMenu == 'payments' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">payments</span>
            <span>Paiements</span>
        </a>
        <a href="/receipts" class="sidebar-link {{ activeMenu == 'receipts' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">receipt_long</span>
            <span>Quittances</span>
        </a>
    </nav>
    <div class="mt-auto pt-4 border-t border-slate-800/50 flex flex-col gap-1">
        <a href="/settings" class="sidebar-link {{ activeMenu == 'settings' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">settings</span>
            <span>Paramètres</span>
        </a>
        <form method="post" action="/logout">
            <button type="submit" class="sidebar-link sidebar-link-inactive hover:text-error hover:bg-red-500/10 w-full text-left">
                <span class="material-symbols-outlined text-[20px]">logout</span>
                <span>Déconnexion</span>
            </button>
        </form>
    </div>
</aside>

{# ── Mobile Sidebar ──────────────────────────────────────────────────── #}
<div id="mobile-overlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden" onclick="closeMobileNav()"></div>
<aside id="mobile-nav" class="fixed h-full w-[280px] left-0 top-0 lg:hidden flex flex-col bg-slate-950 p-4 gap-2 z-50 -translate-x-full transition-transform duration-300">
    <div class="mb-6 px-2 flex items-center justify-between">
        <div>
            <span class="text-xl font-bold tracking-tighter text-white">Rent Receipt</span>
            <p class="text-xs text-slate-400 tracking-tight">Gestion immobilière</p>
        </div>
        <button onclick="closeMobileNav()" class="text-slate-400 hover:text-white p-1">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
    <nav class="flex flex-col gap-1 flex-grow overflow-y-auto">
        <a href="/" onclick="closeMobileNav()" class="sidebar-link {{ activeMenu == 'dashboard' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">dashboard</span>
            <span>Tableau de bord</span>
        </a>
        <p class="px-3 pt-4 pb-1 text-[10px] font-bold tracking-widest text-slate-600 uppercase">Gestion</p>
        <a href="/owners" onclick="closeMobileNav()" class="sidebar-link {{ activeMenu == 'owners' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">person</span>
            <span>Bailleurs</span>
        </a>
        <a href="/tenants" onclick="closeMobileNav()" class="sidebar-link {{ activeMenu == 'tenants' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">groups</span>
            <span>Locataires</span>
        </a>
        <a href="/properties" onclick="closeMobileNav()" class="sidebar-link {{ activeMenu == 'properties' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">apartment</span>
            <span>Biens</span>
        </a>
        <p class="px-3 pt-4 pb-1 text-[10px] font-bold tracking-widest text-slate-600 uppercase">Loyers</p>
        <a href="/payments" onclick="closeMobileNav()" class="sidebar-link {{ activeMenu == 'payments' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">payments</span>
            <span>Paiements</span>
        </a>
        <a href="/receipts" onclick="closeMobileNav()" class="sidebar-link {{ activeMenu == 'receipts' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">receipt_long</span>
            <span>Quittances</span>
        </a>
    </nav>
    <div class="mt-auto pt-4 border-t border-slate-800/50 flex flex-col gap-1">
        <a href="/settings" onclick="closeMobileNav()" class="sidebar-link {{ activeMenu == 'settings' ? 'sidebar-link-active' : 'sidebar-link-inactive' }}">
            <span class="material-symbols-outlined text-[20px]">settings</span>
            <span>Paramètres</span>
        </a>
        <form method="post" action="/logout">
            <button type="submit" class="sidebar-link sidebar-link-inactive hover:text-error hover:bg-red-500/10 w-full text-left">
                <span class="material-symbols-outlined text-[20px]">logout</span>
                <span>Déconnexion</span>
            </button>
        </form>
    </div>
</aside>

{# ── Topbar ──────────────────────────────────────────────────────────── #}
<header class="fixed top-0 right-0 left-0 lg:left-[220px] h-16 z-40 bg-white/80 backdrop-blur-xl border-b border-surface-container flex items-center px-6 gap-4">
    <button onclick="toggleMobileNav()" class="lg:hidden text-on-surface-variant hover:text-on-surface transition-colors">
        <span class="material-symbols-outlined">menu</span>
    </button>
    <span class="lg:hidden font-bold tracking-tight text-on-surface">Rent Receipt</span>
</header>

{# ── Main Content ────────────────────────────────────────────────────── #}
<main class="pt-24 pb-12 px-4 md:px-6 lg:ml-[220px] max-w-7xl mx-auto">
    {% if flash %}
        <div id="flash-msg" class="mb-6 flex items-start gap-3 px-4 py-3 rounded-xl text-sm font-medium
            {{ flash.type == 'error'
                ? 'bg-error-container text-on-error-container'
                : 'bg-tertiary-container text-on-tertiary-container' }}">
            <span class="material-symbols-outlined text-[18px] mt-0.5">
                {{ flash.type == 'error' ? 'error' : 'check_circle' }}
            </span>
            <span class="flex-1">{{ flash.message }}</span>
            <button onclick="document.getElementById('flash-msg').remove()" class="opacity-60 hover:opacity-100 transition-opacity">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    {% endif %}
    {% block content %}{% endblock %}
</main>

{% block scripts %}{% endblock %}

<script>
    const mobileNav = document.getElementById('mobile-nav');
    const overlay   = document.getElementById('mobile-overlay');
    function openMobileNav() {
        mobileNav.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }
    function closeMobileNav() {
        mobileNav.classList.add('-translate-x-full');
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
    }
    function toggleMobileNav() {
        mobileNav.classList.contains('-translate-x-full') ? openMobileNav() : closeMobileNav();
    }
</script>
</body>
</html>
