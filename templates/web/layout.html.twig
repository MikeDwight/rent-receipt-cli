<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Rent Receipt{% endblock %} — Rent Receipt</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <style>
        body { background: #f8f9fa; }
        .navbar-brand { font-weight: 700; }
        .sidebar { min-height: calc(100vh - 56px); background: #fff; border-right: 1px solid #dee2e6; }
        .sidebar .nav-link { color: #495057; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #0d6efd; background: #e9ecef; border-radius: .375rem; }
        .main-content { padding: 2rem; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">🏠 Rent Receipt</a>
        <div class="ms-auto">
            <form method="post" action="/logout" class="d-inline">
                <button type="submit" class="btn btn-outline-light btn-sm">Déconnexion</button>
            </form>
        </div>
    </div>
</nav>

<div class="container-fluid">
    <div class="row">
        <nav class="col-md-2 sidebar py-3">
            <ul class="nav flex-column gap-1">
                <li class="nav-item"><a class="nav-link {% if activeMenu == 'dashboard' %}active{% endif %}" href="/">Tableau de bord</a></li>
                <li class="nav-item mt-2 text-muted small px-3">GESTION</li>
                <li class="nav-item"><a class="nav-link {% if activeMenu == 'owners' %}active{% endif %}" href="/owners">Bailleurs</a></li>
                <li class="nav-item"><a class="nav-link {% if activeMenu == 'tenants' %}active{% endif %}" href="/tenants">Locataires</a></li>
                <li class="nav-item"><a class="nav-link {% if activeMenu == 'properties' %}active{% endif %}" href="/properties">Biens</a></li>
                <li class="nav-item mt-2 text-muted small px-3">LOYERS</li>
                <li class="nav-item"><a class="nav-link {% if activeMenu == 'payments' %}active{% endif %}" href="/payments">Paiements</a></li>
                <li class="nav-item"><a class="nav-link {% if activeMenu == 'receipts' %}active{% endif %}" href="/receipts">Quittances</a></li>
            </ul>
        </nav>

        <main class="col-md-10 main-content">
            {% if flash %}
                <div class="alert alert-{{ flash.type == 'error' ? 'danger' : 'success' }} alert-dismissible fade show" role="alert">
                    {{ flash.message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}
            {% block content %}{% endblock %}
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
