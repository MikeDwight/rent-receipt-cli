{% extends 'layout.html.twig' %}
{% set activeMenu = 'properties' %}
{% block title %}{{ property ? 'Modifier bien' : 'Nouveau bien' }}{% endblock %}

{% block content %}
<div class="flex items-center gap-4 mb-8">
    <a href="/properties" class="inline-flex items-center gap-1.5 text-sm text-on-surface-variant hover:text-on-surface transition-colors">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        Retour
    </a>
    <h1 class="text-3xl font-bold tracking-tight text-on-surface">
        {{ property ? 'Modifier bien' : 'Nouveau bien' }}
    </h1>
</div>

<div class="bg-surface-container-lowest rounded-xl custom-shadow p-8 max-w-2xl">
    <form method="post" action="{{ property ? '/properties/' ~ property.id : '/properties' }}">
        <div class="mb-6">
            <label class="block text-sm font-medium text-on-surface mb-2">
                Bailleur <span class="text-error">*</span>
            </label>
            <select name="owner_id" required
                    class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                <option value="">— choisir —</option>
                {% for o in owners %}
                    <option value="{{ o.id }}" {{ (property.owner_id ?? '') == o.id ? 'selected' : '' }}>{{ o.full_name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="mb-6">
            <label class="block text-sm font-medium text-on-surface mb-2">
                Libellé <span class="text-error">*</span>
            </label>
            <input type="text" name="label"
                   class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                   value="{{ property.label ?? '' }}" required>
        </div>
        <div class="mb-6">
            <label class="block text-sm font-medium text-on-surface mb-2">
                Adresse <span class="text-error">*</span>
            </label>
            <input type="text" name="address"
                   class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                   value="{{ property.address ?? '' }}" required>
        </div>
        <div class="grid grid-cols-2 gap-4 mb-8">
            <div>
                <label class="block text-sm font-medium text-on-surface mb-2">
                    Loyer (€) <span class="text-error">*</span>
                </label>
                <input type="number" step="0.01" name="rent_amount" required
                       class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                       value="{{ property ? (property.rent_amount / 100)|number_format(2, '.', '') : '' }}">
            </div>
            <div>
                <label class="block text-sm font-medium text-on-surface mb-2">Charges (€)</label>
                <input type="number" step="0.01" name="charges_amount"
                       class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                       value="{{ property ? (property.charges_amount / 100)|number_format(2, '.', '') : '0.00' }}">
            </div>
        </div>
        <button type="submit"
                class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-br from-primary to-primary-dim text-on-primary rounded-xl font-semibold text-sm hover:opacity-95 transition-opacity">
            <span class="material-symbols-outlined text-[18px]">save</span>
            Enregistrer
        </button>
    </form>
</div>
{% endblock %}
