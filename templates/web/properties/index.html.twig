{% extends 'layout.html.twig' %}
{% set activeMenu = 'properties' %}
{% block title %}Biens{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Biens</h2>
    <a href="/properties/new" class="btn btn-primary btn-sm">+ Nouveau</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Libellé</th><th>Adresse</th><th>Loyer</th><th>Charges</th><th>Bailleur</th><th></th></tr>
            </thead>
            <tbody>
            {% for p in properties %}
                <tr>
                    <td class="text-muted">{{ p.id }}</td>
                    <td>{{ p.label }}</td>
                    <td>{{ p.address }}</td>
                    <td>{{ (p.rent_amount / 100)|number_format(2, ',', ' ') }} €</td>
                    <td>{{ (p.charges_amount / 100)|number_format(2, ',', ' ') }} €</td>
                    <td>{{ owners[p.owner_id].full_name ?? '—' }}</td>
                    <td class="text-end">
                        <a href="/properties/{{ p.id }}/edit" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        <form method="post" action="/properties/{{ p.id }}/delete" class="d-inline"
                              onsubmit="return confirm('Supprimer ce bien ?')">
                            <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-muted text-center py-3">Aucun bien.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
