{% extends 'layout.html.twig' %}
{% set activeMenu = 'properties' %}
{% block title %}Biens{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fs-4">Biens</h2>
    <a href="/properties/new" class="btn btn-primary btn-sm">+ Nouveau</a>
</div>

<div class="card border-0 shadow-sm">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Libellé</th>
                <th>Loyer</th>
                <th class="d-none d-md-table-cell">Charges</th>
                <th class="d-none d-md-table-cell">Adresse</th>
                <th class="d-none d-md-table-cell">Bailleur</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for p in properties %}
            <tr>
                <td>{{ p.label }}</td>
                <td>{{ (p.rent_amount / 100)|number_format(2, ',', ' ') }} €</td>
                <td class="d-none d-md-table-cell">{{ (p.charges_amount / 100)|number_format(2, ',', ' ') }} €</td>
                <td class="d-none d-md-table-cell">{{ p.address }}</td>
                <td class="d-none d-md-table-cell">{{ owners[p.owner_id].full_name ?? '—' }}</td>
                <td class="text-end" style="white-space:nowrap">
                    <a href="/properties/{{ p.id }}/edit" class="btn btn-sm btn-outline-secondary" title="Modifier">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form method="post" action="/properties/{{ p.id }}/delete" class="d-inline"
                          onsubmit="return confirm('Supprimer ce bien ?')">
                        <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-muted text-center py-3">Aucun bien.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
