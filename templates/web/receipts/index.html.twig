{% extends 'layout.html.twig' %}
{% set activeMenu = 'receipts' %}
{% block title %}Quittances{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Quittances</h2>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                <span class="fw-semibold">Liste — {{ month }}</span>
                <form method="get" action="/receipts" class="d-flex gap-2">
                    <input type="text" name="month" class="form-control form-control-sm" value="{{ month }}" placeholder="YYYY-MM" style="width:120px">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Go</button>
                </form>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Période</th><th>Email envoyé</th><th>Archivé</th></tr>
                    </thead>
                    <tbody>
                    {% for r in receipts %}
                        <tr>
                            <td class="text-muted">{{ r.id }}</td>
                            <td>{{ r.period ?? '—' }}</td>
                            <td>
                                {% if r.sent_at %}
                                    <span class="badge bg-success">✓ {{ r.sent_at|slice(0,10) }}</span>
                                {% elseif r.send_error %}
                                    <span class="badge bg-danger" title="{{ r.send_error }}">Erreur</span>
                                {% else %}
                                    <span class="badge bg-secondary">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if r.archived_at %}
                                    <span class="badge bg-success">✓ {{ r.archived_at|slice(0,10) }}</span>
                                {% elseif r.archive_error %}
                                    <span class="badge bg-danger" title="{{ r.archive_error }}">Erreur</span>
                                {% else %}
                                    <span class="badge bg-secondary">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-muted text-center py-3">Aucune quittance pour {{ month }}.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">⚡ Traiter un paiement</div>
            <div class="card-body">
                <form method="post" action="/receipts/process">
                    <div class="mb-2">
                        <label class="form-label small">Locataire</label>
                        <select name="tenant_id" class="form-select form-select-sm" required>
                            <option value="">-- choisir --</option>
                            {% for t in tenants %}
                                <option value="{{ t.id }}">{{ t.full_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Bien</label>
                        <select name="property_id" class="form-select form-select-sm" required>
                            <option value="">-- choisir --</option>
                            {% for p in properties %}
                                <option value="{{ p.id }}">{{ p.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Période</label>
                        <div class="d-flex gap-1 mb-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillPeriod(0)">Mois en cours</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillPeriod(-1)">Mois précédent</button>
                        </div>
                        <div class="d-flex gap-1 align-items-center">
                            <input type="date" id="period_start" name="period_start" class="form-control form-control-sm" required>
                            <span class="small text-muted">au</span>
                            <input type="date" id="period_end" name="period_end" class="form-control form-control-sm" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Payé le</label>
                        <input type="date" name="paid_at" class="form-control form-control-sm" value="{{ "now"|date("Y-m-d") }}">
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">Traiter →</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function fillPeriod(offset) {
    const now = new Date();
    const d = new Date(now.getFullYear(), now.getMonth() + offset, 1);
    const year = d.getFullYear();
    const month = d.getMonth();
    const first = year + '-' + String(month + 1).padStart(2, '0') + '-01';
    const lastDay = new Date(year, month + 1, 0).getDate();
    const last = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(lastDay).padStart(2, '0');
    document.getElementById('period_start').value = first;
    document.getElementById('period_end').value = last;
}
fillPeriod(-1);
</script>
{% endblock %}
