{% extends 'layout.html.twig' %}
{% set activeMenu = 'receipts' %}
{% block title %}Quittances{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Suivi des quittances</h2>
    <form method="get" action="/receipts" class="d-flex gap-2">
        <input type="text" name="month" class="form-control form-control-sm" value="{{ month }}" placeholder="YYYY-MM" style="width:120px">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Go</button>
    </form>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Période</th><th>Locataire</th><th>Email envoyé</th><th>Archivé</th></tr>
            </thead>
            <tbody>
            {% for r in receipts %}
                <tr>
                    <td class="text-muted">{{ r.id }}</td>
                    <td>{{ r.period ?? '—' }}</td>
                    <td>{{ r.tenant_name ?? '—' }}</td>
                    <td>
                        {% if r.sent_at %}
                            <span class="badge bg-success">✓ {{ r.sent_at|slice(0,10) }}</span>
                        {% elseif r.send_error %}
                            <span class="badge bg-danger" title="{{ r.send_error }}">Erreur</span>
                        {% else %}
                            <span class="badge bg-secondary">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if r.archived_at %}
                            <span class="badge bg-success">✓ {{ r.archived_at|slice(0,10) }}</span>
                        {% elseif r.archive_error %}
                            <span class="badge bg-danger" title="{{ r.archive_error }}">Erreur</span>
                        {% else %}
                            <span class="badge bg-secondary">—</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-muted text-center py-3">Aucune quittance pour {{ month }}.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
