{% extends 'layout.html.twig' %}
{% set activeMenu = 'receipts' %}
{% block title %}Quittances{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fs-4">Quittances</h2>
    <form method="get" action="/receipts" class="d-flex gap-2">
        <input type="text" name="month" class="form-control form-control-sm" value="{{ month }}" placeholder="YYYY-MM" style="width:110px">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Go</button>
    </form>
</div>

<div class="card border-0 shadow-sm">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Période</th>
                <th>Locataire</th>
                <th>Email</th>
                <th class="d-none d-md-table-cell">Archivé</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for r in receipts %}
            <tr>
                <td>{{ r.period ?? '—' }}</td>
                <td>{{ r.tenant_name ?? '—' }}</td>
                <td>
                    {% if r.sent_at %}
                        <span class="badge bg-success">✓ <span class="d-none d-md-inline">{{ r.sent_at|slice(0,10) }}</span></span>
                    {% elseif r.send_error %}
                        <span class="badge bg-danger" title="{{ r.send_error }}">Erreur</span>
                    {% else %}
                        <span class="badge bg-secondary">—</span>
                    {% endif %}
                </td>
                <td class="d-none d-md-table-cell">
                    {% if r.archived_at %}
                        <span class="badge bg-success">✓ {{ r.archived_at|slice(0,10) }}</span>
                    {% elseif r.archive_error %}
                        <span class="badge bg-danger" title="{{ r.archive_error }}">Erreur</span>
                    {% else %}
                        <span class="badge bg-secondary">—</span>
                    {% endif %}
                </td>
                <td class="text-end" style="white-space:nowrap">
                    <a href="/receipts/{{ r.id }}/download" class="btn btn-sm btn-outline-primary" title="Télécharger">
                        <i class="bi bi-download"></i>
                    </a>
                    {% if not r.sent_at %}
                        <form method="post" action="/receipts/{{ r.id }}/send" class="d-inline"
                              onsubmit="return confirm('Envoyer la quittance par email au locataire ?')">
                            <button class="btn btn-sm btn-outline-success" title="Envoyer par email">
                                <i class="bi bi-envelope"></i>
                            </button>
                        </form>
                    {% endif %}
                    <form method="post" action="/receipts/{{ r.id }}/delete" class="d-inline"
                          onsubmit="return confirm('Supprimer cette quittance et son PDF ?')">
                        <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="text-muted text-center py-3">Aucune quittance pour {{ month }}.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
