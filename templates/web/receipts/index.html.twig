{% extends 'layout.html.twig' %}
{% set activeMenu = 'receipts' %}
{% block title %}Quittances{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fs-4">Quittances</h2>
    <form method="get" action="/receipts" class="d-flex gap-2">
        <input type="text" name="month" class="form-control form-control-sm" value="{{ month }}" placeholder="YYYY-MM" style="width:110px">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Go</button>
    </form>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Période</th>
                    <th>Locataire</th>
                    <th>Email</th>
                    <th class="d-none d-md-table-cell">Archivé</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for r in receipts %}
                <tr>
                    <td>{{ r.period ?? '—' }}</td>
                    <td>{{ r.tenant_name ?? '—' }}</td>
                    <td>
                        {% if r.sent_at %}
                            <span class="badge bg-success">✓ <span class="d-none d-md-inline">{{ r.sent_at|slice(0,10) }}</span></span>
                        {% elseif r.send_error %}
                            <span class="badge bg-danger" title="{{ r.send_error }}">Erreur</span>
                        {% else %}
                            <span class="badge bg-secondary">—</span>
                        {% endif %}
                    </td>
                    <td class="d-none d-md-table-cell">
                        {% if r.archived_at %}
                            <span class="badge bg-success">✓ {{ r.archived_at|slice(0,10) }}</span>
                        {% elseif r.archive_error %}
                            <span class="badge bg-danger" title="{{ r.archive_error }}">Erreur</span>
                        {% else %}
                            <span class="badge bg-secondary">—</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Actions
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/receipts/{{ r.id }}/download">Télécharger</a></li>
                                {% if not r.sent_at %}
                                    <li>
                                        <form method="post" action="/receipts/{{ r.id }}/send"
                                              onsubmit="return confirm('Envoyer la quittance par email au locataire ?')">
                                            <button class="dropdown-item text-primary">Envoyer par email</button>
                                        </form>
                                    </li>
                                {% endif %}
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="/receipts/{{ r.id }}/delete"
                                          onsubmit="return confirm('Supprimer cette quittance et son PDF ?')">
                                        <button class="dropdown-item text-danger">Supprimer</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-muted text-center py-3">Aucune quittance pour {{ month }}.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
