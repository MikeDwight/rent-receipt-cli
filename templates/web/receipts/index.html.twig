{% extends 'layout.html.twig' %}
{% set activeMenu = 'receipts' %}
{% block title %}Quittances{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fs-4">Quittances</h2>
    <form method="get" action="/receipts" class="d-flex gap-2">
        <input type="text" name="month" class="form-control form-control-sm" value="{{ month }}" placeholder="YYYY-MM" style="width:110px">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Go</button>
    </form>
</div>

<div class="card border-0 shadow-sm">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Période</th>
                <th>Locataire</th>
                <th>Email</th>
                <th class="d-none d-md-table-cell">Archivé</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for r in receipts %}
            <tr>
                <td>{{ r.period ?? '—' }}</td>
                <td>{{ r.tenant_name ?? '—' }}</td>
                <td>
                    {% if r.sent_at %}
                        <span class="badge bg-success">✓ <span class="d-none d-md-inline">{{ r.sent_at|slice(0,10) }}</span></span>
                    {% elseif r.send_error %}
                        <span class="badge bg-danger" title="{{ r.send_error }}">Erreur</span>
                    {% else %}
                        <span class="badge bg-secondary">—</span>
                    {% endif %}
                </td>
                <td class="d-none d-md-table-cell">
                    {% if r.archived_at %}
                        <span class="badge bg-success">✓ {{ r.archived_at|slice(0,10) }}</span>
                    {% elseif r.archive_error %}
                        <span class="badge bg-danger" title="{{ r.archive_error }}">Erreur</span>
                    {% else %}
                        <span class="badge bg-secondary">—</span>
                    {% endif %}
                </td>
                <td class="text-end" style="white-space:nowrap">
                    <button class="btn btn-sm btn-outline-secondary"
                            onclick="openPreview('/receipts/{{ r.id }}/view', '{{ r.tenant_name|default('')|e('js') }} — {{ r.period|default('') }}')">Aperçu</button>
                    <a href="/receipts/{{ r.id }}/download" class="btn btn-sm btn-outline-primary">Télécharger</a>
                    {% if not r.sent_at %}
                        <form method="post" action="/receipts/{{ r.id }}/send" class="d-inline"
                              onsubmit="return confirm('Envoyer la quittance par email au locataire ?')">
                            <button class="btn btn-sm btn-outline-success">Envoyer</button>
                        </form>
                    {% endif %}
                    <form method="post" action="/receipts/{{ r.id }}/delete" class="d-inline"
                          onsubmit="return confirm('Supprimer cette quittance et son PDF ?')">
                        <button class="btn btn-sm btn-outline-danger">Suppr.</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="text-muted text-center py-3">Aucune quittance pour {{ month }}.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# Modal preview #}
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content d-flex flex-column" style="height:90vh">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0" id="previewTitle">Aperçu quittance</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="flex:1;min-height:0">
                <iframe id="previewFrame" src="" style="width:100%;height:100%;border:none"></iframe>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function openPreview(url, title) {
    document.getElementById('previewFrame').src = url;
    document.getElementById('previewTitle').textContent = title || 'Aperçu quittance';
    new bootstrap.Modal(document.getElementById('previewModal')).show();
}
document.getElementById('previewModal').addEventListener('hidden.bs.modal', function () {
    document.getElementById('previewFrame').src = '';
});
</script>
{% endblock %}
