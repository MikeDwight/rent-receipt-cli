{% extends 'layout.html.twig' %}
{% set activeMenu = 'tenants' %}
{% block title %}{{ tenant ? 'Modifier locataire' : 'Nouveau locataire' }}{% endblock %}

{% block content %}
<div class="flex items-center gap-4 mb-8">
    <a href="/tenants" class="inline-flex items-center gap-1.5 text-sm text-on-surface-variant hover:text-on-surface transition-colors">
        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        Retour
    </a>
    <h1 class="text-3xl font-bold tracking-tight text-on-surface">
        {{ tenant ? 'Modifier locataire' : 'Nouveau locataire' }}
    </h1>
</div>

<div class="bg-surface-container-lowest rounded-xl custom-shadow p-8 max-w-2xl">
    <form method="post" action="{{ tenant ? '/tenants/' ~ tenant.id : '/tenants' }}">
        <div class="mb-6">
            <label class="block text-sm font-medium text-on-surface mb-2">
                Nom complet <span class="text-error">*</span>
            </label>
            <input type="text" name="full_name"
                   class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                   value="{{ tenant.full_name ?? '' }}" required>
        </div>
        <div class="mb-6">
            <label class="block text-sm font-medium text-on-surface mb-2">Email</label>
            <input type="email" name="email"
                   class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                   value="{{ tenant.email ?? '' }}">
        </div>
        <div class="mb-8">
            <label class="block text-sm font-medium text-on-surface mb-2">
                Adresse <span class="text-error">*</span>
            </label>
            <input type="text" name="address"
                   class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                   value="{{ tenant.address ?? '' }}" required>
        </div>
        <button type="submit"
                class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-br from-primary to-primary-dim text-on-primary rounded-xl font-semibold text-sm hover:opacity-95 transition-opacity">
            <span class="material-symbols-outlined text-[18px]">save</span>
            Enregistrer
        </button>
    </form>
</div>
{% endblock %}
