{% extends 'layout.html.twig' %}
{% set activeMenu = 'settings' %}
{% block title %}Paramètres{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fs-4">Paramètres</h2>
</div>

<form method="post" action="/settings">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">Nextcloud — Archivage</div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-medium" for="nextcloud_target_dir">Dossier de destination</label>
                <input type="text" class="form-control" id="nextcloud_target_dir" name="nextcloud_target_dir"
                       value="{{ nextcloud_target_dir }}"
                       placeholder="ex: Loyers/Quittances">
                <div class="form-text">
                    Chemin dans Nextcloud où les quittances PDF sont archivées.
                    Si vide, le dossier par défaut <code>archives/YYYY-MM/</code> est utilisé.
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
</form>
{% endblock %}
