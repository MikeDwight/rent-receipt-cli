{% extends 'layout.html.twig' %}
{% set activeMenu = 'owners' %}
{% block title %}{{ owner ? 'Modifier bailleur' : 'Nouveau bailleur' }}{% endblock %}

{% block content %}
<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/owners" class="btn btn-sm btn-outline-secondary">← Retour</a>
    <h2 class="mb-0">{{ owner ? 'Modifier bailleur' : 'Nouveau bailleur' }}</h2>
</div>

<div class="card border-0 shadow-sm" style="max-width:600px">
    <div class="card-body">
        <form method="post" action="{{ owner ? '/owners/' ~ owner.id : '/owners' }}">
            <div class="mb-3">
                <label class="form-label">Nom complet <span class="text-danger">*</span></label>
                <input type="text" name="full_name" class="form-control" value="{{ owner.full_name ?? '' }}" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" value="{{ owner.email ?? '' }}">
            </div>
            <div class="mb-3">
                <label class="form-label">Adresse <span class="text-danger">*</span></label>
                <input type="text" name="address" class="form-control" value="{{ owner.address ?? '' }}" required>
            </div>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </form>
    </div>
</div>
{% endblock %}
