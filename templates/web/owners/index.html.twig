{% extends 'layout.html.twig' %}
{% set activeMenu = 'owners' %}
{% block title %}Bailleurs{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-on-surface">Bailleurs</h1>
    <a href="/owners/new" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-br from-primary to-primary-dim text-on-primary rounded-xl font-semibold text-sm hover:opacity-95 transition-opacity">
        <span class="material-symbols-outlined text-[18px]">add</span>
        Nouveau
    </a>
</div>

<div class="bg-surface-container-lowest rounded-xl custom-shadow overflow-hidden">
    {% if owners is empty %}
        <div class="px-6 py-12 text-center text-on-surface-variant text-sm">Aucun bailleur enregistré.</div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low/50">
                        <th class="px-6 py-4 text-[10px] text-on-surface-variant font-bold tracking-widest uppercase">Nom</th>
                        <th class="px-6 py-4 text-[10px] text-on-surface-variant font-bold tracking-widest uppercase hidden md:table-cell">Email</th>
                        <th class="px-6 py-4 text-[10px] text-on-surface-variant font-bold tracking-widest uppercase hidden md:table-cell">Adresse</th>
                        <th class="px-6 py-4"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-low">
                {% for o in owners %}
                    <tr class="hover:bg-surface-container-low/30 transition-colors">
                        <td class="px-6 py-4 font-semibold text-on-surface text-sm">{{ o.full_name }}</td>
                        <td class="px-6 py-4 text-on-surface-variant text-sm hidden md:table-cell">{{ o.email ?: '—' }}</td>
                        <td class="px-6 py-4 text-on-surface-variant text-sm hidden md:table-cell">{{ o.address }}</td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/owners/{{ o.id }}/edit"
                                   class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface-container-high text-on-surface rounded-lg text-xs font-medium hover:bg-surface-container-highest transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">edit</span>
                                    Modifier
                                </a>
                                <form method="post" action="/owners/{{ o.id }}/delete"
                                      onsubmit="return confirm('Supprimer ce bailleur ?')">
                                    <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-error bg-error-container/10 rounded-lg text-xs font-medium hover:bg-error-container/25 transition-colors">
                                        <span class="material-symbols-outlined text-[14px]">delete</span>
                                        Suppr.
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
