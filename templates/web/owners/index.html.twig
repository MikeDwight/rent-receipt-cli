{% extends 'layout.html.twig' %}
{% set activeMenu = 'owners' %}
{% block title %}Bailleurs{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 fs-4">Bailleurs</h2>
    <a href="/owners/new" class="btn btn-primary btn-sm">+ Nouveau</a>
</div>

<div class="card border-0 shadow-sm">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Nom</th>
                <th class="d-none d-md-table-cell">Email</th>
                <th class="d-none d-md-table-cell">Adresse</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for o in owners %}
            <tr>
                <td>{{ o.full_name }}</td>
                <td class="d-none d-md-table-cell">{{ o.email }}</td>
                <td class="d-none d-md-table-cell">{{ o.address }}</td>
                <td class="text-end" style="white-space:nowrap">
                    <a href="/owners/{{ o.id }}/edit" class="btn btn-sm btn-outline-secondary" title="Modifier">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form method="post" action="/owners/{{ o.id }}/delete" class="d-inline"
                          onsubmit="return confirm('Supprimer ce bailleur ?')">
                        <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-muted text-center py-3">Aucun bailleur.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
