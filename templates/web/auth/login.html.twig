<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion — Rent Receipt</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "background": "#fcf9f8",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f6f3f2",
                        "on-surface": "#323233",
                        "on-surface-variant": "#5f5f5f",
                        "primary": "#565e74",
                        "primary-dim": "#4a5268",
                        "on-primary": "#f7f7ff",
                        "tertiary-container": "#69f6b8",
                        "on-tertiary-container": "#005a3c",
                        "error-container": "#fe8983",
                        "on-error-container": "#752121",
                    },
                    borderRadius: {
                        DEFAULT: "0.125rem",
                        lg: "0.25rem",
                        xl: "0.75rem",
                        "2xl": "1rem",
                        full: "9999px",
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .custom-shadow { box-shadow: 0 12px 40px rgba(50, 50, 51, 0.06); }
    </style>
</head>
<body class="bg-background min-h-screen flex items-center justify-center p-4">

<div class="w-full max-w-sm">
    {# Logo / Brand #}
    <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 bg-gradient-to-br from-primary to-primary-dim rounded-2xl mb-4">
            <svg class="w-7 h-7 text-on-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-on-surface">Rent Receipt</h1>
        <p class="text-sm text-on-surface-variant mt-1">Gestion immobilière</p>
    </div>

    {# Card #}
    <div class="bg-surface-container-lowest rounded-2xl custom-shadow p-8">
        {% if flash %}
            <div class="mb-6 flex items-start gap-3 px-4 py-3 rounded-xl text-sm font-medium
                {{ flash.type == 'error'
                    ? 'bg-error-container text-on-error-container'
                    : 'bg-tertiary-container text-on-tertiary-container' }}">
                {{ flash.message }}
            </div>
        {% endif %}

        <form method="post" action="/login">
            <div class="mb-6">
                <label for="password" class="block text-sm font-medium text-on-surface mb-2">
                    Mot de passe
                </label>
                <input type="password" id="password" name="password" autofocus required
                       class="w-full bg-surface-container-low rounded-lg px-4 py-3 text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary">
            </div>
            <button type="submit"
                    class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-br from-primary to-primary-dim text-on-primary rounded-xl font-semibold text-sm hover:opacity-95 transition-opacity">
                Se connecter
            </button>
        </form>
    </div>
</div>

</body>
</html>
